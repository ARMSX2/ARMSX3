<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.RPCSX" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- nothing -->
    </style>

    <!--
      ARMSX3 boot splash. Deliberately NOT DayNight: the window must be black
      before the first video frame decodes, otherwise a light-mode device
      flashes white behind the intro. Matches the layout's black FrameLayout.
    -->
    <style name="Theme.ARMSX3.Boot" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
